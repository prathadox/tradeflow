# ─── Backend ──────────────────────────────────────────────────────────
PORT=3001

# Stellar network: "testnet" or "public"
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org

# Binance ticker source for arbitrage reference price
BINANCE_API_URL=https://api.binance.com

# ─── Supabase / Postgres ──────────────────────────────────────────────
# Use the "Connection pooling" URL from Supabase → Project Settings → Database.
# Format: postgres://postgres:<password>@<host>:6543/postgres
# (the 6543 pooler port is required for serverless-friendly connections)
DATABASE_URL=postgres://postgres:REPLACE_ME@db.xxxx.supabase.co:6543/postgres

# ─── Session signer encryption ───────────────────────────────────────
# Used as key material for AES-256-GCM encryption of session secrets at rest.
# Must be at least 32 chars. Rotate only in coordination with a DB wipe of
# session_signers rows (old ciphertexts become unreadable).
# Generate with: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=REPLACE_ME_with_openssl_rand_hex_32

# ─── Frontend ─────────────────────────────────────────────────────────
# Optional override for API URL; defaults to http://localhost:3001
# VITE_API_URL=http://localhost:3001
